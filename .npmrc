# Keep `pnpm add` writing the workspace protocol inside this repo; `pnpm pack`
# rewrites those ranges to concrete versions in the published tarball, so the
# lockfile and the tarball never disagree about an intra-repo edge.
save-workspace-protocol=rolling

# The @deepseek-ai/* peers are supplied by the harness host at runtime; a
# transitive mismatch is the host's business, not an install blocker here.
strict-peer-dependencies=false
